# 复制为 .env 后再填写。

TINKER_API_KEY=replace_me

# 让 OpenClaw 所在机器连本机时，通常保持 127.0.0.1 即可。
OPENCLAW_PROXY_HOST=127.0.0.1
OPENCLAW_PROXY_PORT=30000
SGLANG_API_KEY=sglang-local

# 默认模型与训练配置。
OPENCLAW_METHOD=combine
OPENCLAW_MODEL_NAME=Qwen/Qwen3.5-4B
OPENCLAW_SERVED_MODEL_NAME=qwen3.5-4b-tinker
OPENCLAW_BATCH_SIZE=8
OPENCLAW_MAX_STEPS=1000
OPENCLAW_PRM_M=1
OPENCLAW_TRAIN_EPOCHS=2
OPENCLAW_W_OPD=1.0
OPENCLAW_W_RL=1.0
OPENCLAW_LEARNING_RATE=1e-4
OPENCLAW_LOSS_FN=ppo

# 行为开关。
OPENCLAW_RL_AUTO_UPDATE=0
OPENCLAW_TINKER_SKIP_INSTALL=0
WANDB_DISABLED=1
WANDB_PROJECT=openclaw-tinker
